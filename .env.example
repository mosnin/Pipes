NODE_ENV=development
LOOPER_USE_MOCKS=true
NEXT_PUBLIC_LOOPER_USE_MOCKS=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CONVEX_DEPLOYMENT=
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter powers real AI loop generation (the agentic reason-act loop in
# /api/agent/build). Set OPENROUTER_API_KEY to switch the editor agent from
# fixtures to live generation. Model defaults to deepseek/deepseek-v4-flash.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Creem subscription billing. Set the product ids for each paid plan.
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_BUILDER=

# x402 pay-per-use for paid marketplace loops. With a facilitator URL set,
# purchases settle on-chain (USDC). Without one, a signed dev voucher path keeps
# the purchase flow working in mock mode.
X402_FACILITATOR_URL=
X402_PAY_TO_ADDRESS=
X402_NETWORK=base-sepolia
X402_ASSET_ADDRESS=

LOOPER_ADMIN_ALLOWLIST=owner@looper.local

MODAL_EXECUTOR_URL=
MODAL_EXECUTOR_TOKEN=

# Agent runner (Phase 2)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
LOOPER_AGENT_ENDPOINT_URL=
OPENAI_AGENTS_MODEL=gpt-4o-mini

# Multi-provider agent runner.
# LOOPER_AGENT_PROVIDER selects the deploy-wide default. Supported values:
# "openai" (default) and "anthropic". Per-request override available via the
# BuildRequest body's `provider` field. ANTHROPIC_AGENTS_MODEL picks the
# Anthropic model; defaults to claude-haiku-4-5-20251001.
LOOPER_AGENT_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_AGENTS_MODEL=claude-haiku-4-5-20251001
