NODE_ENV=development
LOOPER_USE_MOCKS=true
NEXT_PUBLIC_LOOPER_USE_MOCKS=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CONVEX_DEPLOYMENT=
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LOOPER_ADMIN_ALLOWLIST=owner@looper.local

MODAL_EXECUTOR_URL=
MODAL_EXECUTOR_TOKEN=

# Agent runner (Phase 2)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
LOOPER_AGENT_ENDPOINT_URL=
OPENAI_AGENTS_MODEL=gpt-4o-mini

# Multi-provider agent runner.
# LOOPER_AGENT_PROVIDER selects the deploy-wide default. Supported values:
# "openai" (default) and "anthropic". Per-request override available via the
# BuildRequest body's `provider` field. ANTHROPIC_AGENTS_MODEL picks the
# Anthropic model; defaults to claude-haiku-4-5-20251001.
LOOPER_AGENT_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_AGENTS_MODEL=claude-haiku-4-5-20251001
