NODE_ENV=development
PIPES_USE_MOCKS=true
NEXT_PUBLIC_PIPES_USE_MOCKS=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
CONVEX_DEPLOYMENT=
CONVEX_URL=
# Shared secret between this server and Convex. Set the same value on the Convex deployment:
#   npx convex env set PIPES_CONVEX_SERVER_KEY <value>
PIPES_CONVEX_SERVER_KEY=
NEXT_PUBLIC_CONVEX_URL=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Creem product ids for the paid plans (checkout carries the workspace in metadata)
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_BUILDER=
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PIPES_ADMIN_ALLOWLIST=owner@pipes.local
# Required for real sign-in in production: 32+ random characters (e.g. `openssl rand -base64 48`)
PIPES_SESSION_SECRET=
# Encrypts stored connection secrets (defaults to a key derived from PIPES_SESSION_SECRET)
PIPES_ENCRYPTION_KEY=
# Bearer secret for GET /api/cron/schedules; call it every minute or few from a scheduler
CRON_SECRET=

MODAL_EXECUTOR_URL=
MODAL_EXECUTOR_TOKEN=

# Decision models through OpenRouter (docs/decisions.md).
# Without a key, mock mode uses a deterministic stand-in and real mode makes no decisions.
OPENROUTER_API_KEY=
# off | shadow (ask, record, suggest, never act) | live
PIPES_DECISIONS=shadow
PIPES_DECIDER_FAST_MODELS=typesafe/jev-1.14
PIPES_DECIDER_DELIBERATE_MODELS=
PIPES_DECIDER_FAST_TIMEOUT_MS=1500
PIPES_DECIDER_DELIBERATE_TIMEOUT_MS=12000
PIPES_DECIDER_MAX_COST_MICROS=20000
