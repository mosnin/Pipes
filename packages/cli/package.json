{
  "name": "@pipes/cli",
  "version": "0.1.0",
  "description": "CLI for Pipes — build and manage agent systems from your terminal",
  "type": "module",
  "bin": {
    "pipes": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "bundle:linux": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile dist/pipes-linux-x64",
    "bundle:mac": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile dist/pipes-macos-arm64",
    "bundle:mac-x64": "bun build --compile --target=bun-darwin-x64 src/index.ts --outfile dist/pipes-macos-x64",
    "bundle:win": "bun build --compile --target=bun-windows-x64 src/index.ts --outfile dist/pipes-win-x64.exe",
    "bundle:all": "npm run bundle:linux && npm run bundle:mac && npm run bundle:mac-x64 && npm run bundle:win"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "better-sqlite3": "^9.6.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0",
    "sqlite-vec": "^0.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
